@startuml
!include style.puml
skinparam ArrowFontStyle plain
' opaque ref frames, so that the lifelines behind them do not cross their text
skinparam sequenceReferenceBackgroundColor #FFFFFF

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "c:RestoreCommand" as RestoreCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":JsonAddressBookStorage" as JsonAddressBookStorage STORAGE_COLOR
end box

[-> LogicManager : execute("restore old.json")
activate LogicManager

ref over LogicManager, RestoreCommand
AddressBookParser and RestoreCommandParser parse
the input into c, as for other commands, after
checking that old.json is only a file name
end ref

LogicManager -> RestoreCommand : execute(m)
activate RestoreCommand

create JsonAddressBookStorage
RestoreCommand -> JsonAddressBookStorage
activate JsonAddressBookStorage

JsonAddressBookStorage --> RestoreCommand
deactivate JsonAddressBookStorage

RestoreCommand -> JsonAddressBookStorage : readAddressBook()
activate JsonAddressBookStorage

JsonAddressBookStorage --> RestoreCommand : restoredData
deactivate JsonAddressBookStorage

ref over RestoreCommand, Model
c backs up the current data of m to a new
file in data/backups through a BackupCommand,
as backup does, and gets its path
end ref

note right of RestoreCommand
If the backup is missing, cannot be read
or is invalid, or the current data cannot
be backed up, c throws a CommandException
before this point, so the data is not changed.
end note

RestoreCommand -> Model : setAddressBook(restoredData)
activate Model

Model --> RestoreCommand
deactivate Model

RestoreCommand -> Model : updateFilteredPatientList(...)
activate Model

Model --> RestoreCommand
deactivate Model

create CommandResult
RestoreCommand -> CommandResult
activate CommandResult

CommandResult --> RestoreCommand
deactivate CommandResult

RestoreCommand --> LogicManager : r
deactivate RestoreCommand

note right of LogicManager
LogicManager then saves m, even if its data
is unchanged, replacing data/mediconnect.json.
end note

[<-- LogicManager
deactivate LogicManager
@enduml
