<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="patientDetailPanel" fitToWidth="true" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">
  <VBox spacing="6">
    <padding>
      <Insets top="10" right="10" bottom="10" left="10" />
    </padding>

    <Label fx:id="placeholder" styleClass="label-bright" wrapText="true" />

    <VBox fx:id="details" spacing="6">
      <Label fx:id="name" styleClass="detail-name" wrapText="true" />
      <Label fx:id="listIndex" styleClass="label-bright" wrapText="true" />
      <VBox fx:id="basicDetails" spacing="6" />

      <Label fx:id="medicationsHeading" styleClass="detail-heading" />
      <VBox fx:id="medications" spacing="2" />

      <Label fx:id="allergensHeading" styleClass="detail-heading" />
      <VBox fx:id="allergens" spacing="2" />

      <Label fx:id="careInstructionsHeading" styleClass="detail-heading" />
      <VBox fx:id="careInstructions" spacing="2" />

      <Label fx:id="contactsHeading" styleClass="detail-heading" />
      <VBox fx:id="contacts" spacing="2" />

      <Label fx:id="appointmentsHeading" styleClass="detail-heading" />
      <VBox fx:id="appointments" spacing="2" />
    </VBox>
  </VBox>
</ScrollPane>
