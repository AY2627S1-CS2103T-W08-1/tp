<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root title="Help" type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <!-- Bounded size so the window fits 1280 x 720 at 150% scaling; long lines wrap and the rest scrolls. -->
      <VBox fx:id="helpWindowContent" prefWidth="560.0" prefHeight="400.0">
        <children>
          <VBox fx:id="userGuideBox" spacing="6.0">
            <children>
              <Label fx:id="userGuideMessage" maxWidth="Infinity" minHeight="-Infinity" wrapText="true" />
              <Button fx:id="copyButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#copyUrl"
                      text="Copy URL" />
            </children>
            <padding>
              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
          </VBox>
          <ScrollPane fx:id="helpScrollPane" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
            <content>
              <VBox fx:id="helpMessageContainer">
                <children>
                  <Label fx:id="helpMessage" maxWidth="Infinity" text="Label" wrapText="true" />
                </children>
                <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
              </VBox>
            </content>
          </ScrollPane>
        </children>
      </VBox>
    </Scene>
  </scene>
</fx:root>
