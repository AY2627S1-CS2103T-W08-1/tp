@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":VersionedPatientData" as VersionedPatientData MODEL_COLOR
end box

[-> Model : undoPatientData()
activate Model

Model -> VersionedPatientData : undo()
activate VersionedPatientData

VersionedPatientData -> VersionedPatientData :resetData(ReadOnlyAddressBook)
VersionedPatientData --> Model :
deactivate VersionedPatientData

[<-- Model
deactivate Model

@enduml
