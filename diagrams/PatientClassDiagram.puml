@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam ranksep 60
skinparam nodesep 30
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam classAttributeFontColor #FFFFFF

Class Patient {
  archived : boolean
  allergens : List<String>
  careInstructions : List<String>
}
Class Medication {
  description : String
  times : List<LocalTime>
}
Class Contact {
  name : String
  role : String
  phone : String
  note : String
}
Class Appointment {
  date : LocalDate
  time : LocalTime
  provider : String
  note : String
}
show Patient fields
show Medication fields
show Contact fields
show Appointment fields
Class Name
Class Phone
Class Address
Class Nric
Class Dob

Patient --> "*" Medication
Patient --> "*" Contact
Patient --> "*" Appointment
Patient --> "1" Name
Patient --> "1" Phone
Patient --> "1" Address
Patient --> "1" Nric
Patient --> "1" Dob

Medication -[hidden]right-> Contact
Contact -[hidden]right-> Appointment
Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> Nric
Nric -[hidden]right-> Dob
@enduml
